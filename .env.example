# Pterodactyl application API credentials. Keep these server-side only.
PTERODACTYL_PANEL_URL=https://panel.example.com
PTERODACTYL_API_KEY=your-application-api-key
# User/client key from the Pterodactyl panel: Account -> API
PTERODACTYL_CLIENT_API_KEY=your-user-api-key
# Optional server-side Modrinth API token (never expose this to the browser).
MODRINTH_API_TOKEN=
PTERODACTYL_NODE_ID=1
PTERODACTYL_ALLOCATION_ID=1
PTERODACTYL_NEST_ID=1
PTERODACTYL_EGG_ID=5
PTERODACTYL_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERODACTYL_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}